# Kept in sync by hand with .gitignore's spirit, but scoped to what the Docker
# build context never needs — see docker/Dockerfile (build from the repo root).

node_modules
**/node_modules

# build output (regenerated by the build stage)
.next
**/.next
dist
**/dist
*.tsbuildinfo
next-env.d.ts

# local Postgres data / app data volumes
.pgdata*
**/.pgdata*
data
**/data

# env files (secrets) — never bake these into an image layer
.env
.env.*
!.env.example
!**/.env.example

# vcs / editor / os
.git
.gitignore
.github
.idea
.vscode
.DS_Store
Thumbs.db

# tests
coverage
playwright-report
test-results
blob-report
e2e/.auth

# docs (not needed inside the image)
docs

# logs
npm-debug.log*
*.log
