# PostgreSQL connection. `npm run db:dev` starts an embedded server matching this URL.
DATABASE_URL=postgresql://kiri:kiri@localhost:5432/kiri

# 32+ random bytes, e.g. `openssl rand -base64 48`. Derives session and credential
# encryption keys. Losing it invalidates stored plugin cookies (by design).
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional: set while rotating APP_SECRET. Put the OLD secret here after moving
# a new value into APP_SECRET; credentials encrypted under the old key still
# decrypt until re-encrypted. Remove once rotation is done.
# APP_SECRET_PREVIOUS=

# Public origin of this instance (used for absolute links, invites, auth cookies).
PUBLIC_URL=http://localhost:3000

# Where library images, covers, plugins and temp files live. Defaults to ./data.
# DATA_ROOT=./data

# Optional: Cloudflare Access sign-in bridge (see docs/DEPLOY.md).
# AUTH_CF_ACCESS=1
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=...
# AUTH_CF_TRUST_HEADER=0   # requires an https PUBLIC_URL; only behind Cloudflare

# Set to 1 when a reverse proxy or Cloudflare sits in front of this instance, so
# auth rate limiting can read the client IP from cf-connecting-ip /
# x-forwarded-for. Leave at 0 when the app is reachable directly: those headers
# are client-supplied, and trusting them lets an attacker sidestep the limits.
# AUTH_TRUST_PROXY=0

# Background jobs
# JOB_CONCURRENCY=1
# JOB_TIMEOUT_MS=7200000
# KIRI_PLUGIN_SANDBOX=warn
