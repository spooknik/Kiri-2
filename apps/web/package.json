{
  "name": "kiri",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Kiri web app \u2014 collaborative reading tracker and offline reader",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:sw": "tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:dev": "node scripts/db-dev.mts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "import:v1": "tsx scripts/import-v1.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "better-auth": "^1.7.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@serwist/cli": "^9.5.12",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "prisma": "^7.10.0",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "license": "AGPL-3.0-only"
}
