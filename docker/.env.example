# Copy to docker/.env and fill in the two required values before running
# `docker compose -f docker/docker-compose.yml up`. See docs/DEPLOY.md.

# Required. Password for the `kiri` Postgres user/database the `db` service
# creates on first start. Pick something strong; there is no default.
POSTGRES_PASSWORD=

# Required. 32+ random bytes, e.g. `openssl rand -base64 48`. Derives session
# and credential-encryption keys. Losing it invalidates stored plugin cookies
# (by design) — back it up with the rest of your secrets.
APP_SECRET=

# Optional: set while rotating APP_SECRET. Put the OLD secret here after
# moving a new value into APP_SECRET above; credentials encrypted under the
# old key still decrypt until re-encrypted. Remove once rotation is done.
# APP_SECRET_PREVIOUS=

# Public origin of this instance (used for absolute links, invites and auth
# cookies). Set this to the URL users actually load in a browser, scheme
# included — e.g. https://kiri.example.com behind a reverse proxy.
PUBLIC_URL=http://localhost:3000

# Host port to publish the app on.
# APP_PORT=3000

# Pin a specific published image instead of the default `:latest`. Append
# `-browser` for the Playwright/Chromium-capable variant (docs/DEPLOY.md).
# KIRI_IMAGE=ghcr.io/spooknik/kiri:v2.0.0

# Stamped into the UI/version endpoints when building locally with `--build`;
# has no effect when pulling a published image (already baked in).
# NEXT_PUBLIC_APP_VERSION=

# --- Cloudflare Access mode (optional) --------------------------------------
# See docs/DEPLOY.md "Cloudflare Access mode". Leave unset for normal
# email+password login on a LAN or behind a plain reverse proxy.
# AUTH_CF_ACCESS=1
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# AUTH_CF_TRUST_HEADER=0

# --- Background jobs (optional, defaults shown) ------------------------------
# JOB_CONCURRENCY=1
# JOB_TIMEOUT_MS=7200000

# Plugin sandbox. `on` (the compose default) refuses to run a plugin the
# sandbox cannot be applied to. `warn` is a compatibility mode: it logs the
# failure and retries the plugin unsandboxed — only for a plugin you trust on
# a host whose kernel cannot sandbox it. `off` disables it entirely.
# KIRI_PLUGIN_SANDBOX=on
